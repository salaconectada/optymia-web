---
// Floating direct-WhatsApp button.
const whatsappNumber = '56958140808';
const defaultMessage = 'Hola, vengo desde la web de Optymia y me gustaría más información.';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<a
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="fixed bottom-5 right-5 z-[9999] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-2xl transition hover:scale-105 hover:bg-[#20bd5a]"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="h-8 w-8" fill="currentColor" aria-hidden="true">
    <path
      d="M16.004 3C9.376 3 4 8.373 4 15c0 2.312.646 4.472 1.766 6.312L4 29l7.884-1.7A11.93 11.93 0 0 0 16.004 27C22.63 27 28 21.627 28 15S22.63 3 16.004 3Zm0 21.75c-1.93 0-3.75-.51-5.33-1.4l-.383-.222-4.68 1.01 1.05-4.55-.25-.398A9.7 9.7 0 0 1 5.25 15c0-5.93 4.822-10.75 10.754-10.75S26.75 9.07 26.75 15 21.936 24.75 16.004 24.75Zm5.86-8.06c-.32-.16-1.9-.937-2.194-1.044-.294-.107-.508-.16-.722.16-.213.32-.827 1.044-1.014 1.258-.187.213-.374.24-.694.08-.32-.16-1.35-.497-2.573-1.586-.951-.848-1.594-1.895-1.78-2.215-.188-.32-.02-.492.14-.652.144-.144.32-.374.48-.56.16-.187.213-.32.32-.534.107-.213.053-.4-.027-.56-.08-.16-.722-1.74-.99-2.383-.26-.626-.526-.54-.722-.55l-.615-.01c-.213 0-.56.08-.854.4-.294.32-1.12 1.094-1.12 2.668 0 1.574 1.147 3.094 1.307 3.308.16.213 2.257 3.446 5.468 4.833.764.33 1.36.527 1.825.674.767.244 1.465.21 2.017.127.615-.092 1.9-.777 2.168-1.527.267-.75.267-1.393.187-1.527-.08-.133-.293-.213-.613-.373Z"
    ></path>
  </svg>
</a>
